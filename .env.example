# Neon Postgres connection string (pooled).
DATABASE_URL=

# ElevenLabs API key. Server only. Do not use a NEXT_PUBLIC_ prefix.
ELEVENLABS_API_KEY=

# Printed by `npm run agent:setup` on the first run.
ELEVENLABS_AGENT_ID=

# Development only. Set to 1 to limit the interview to q1, q2, q3, and q12.
# Do not set this on Vercel.
# INTERVIEW_SHORT_MODE=1
